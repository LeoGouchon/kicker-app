{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-doc-length.mjs\"",
                        "timeout": 10,
                        "statusMessage": "Vérification de la taille des docs"
                    }
                ]
            }
        ]
    }
}
